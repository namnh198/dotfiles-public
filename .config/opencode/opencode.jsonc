{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-pty"],
  "provider": {
    "ramcloud-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RamCloud OpenAI",
      "options": {
        "baseURL": "https://ramclouds.me/v1",
        "apiKey": "{env:RAMCLOUDS_API_KEY}",
      },
      "models": {
        "gpt-5": {
          "id": "gpt-5",
          "name": "GPT-5 (1.25 - 10.0)",
        },
        "minimax-m2.1": {
          "id": "minimax-m2.1",
          "name": "Minimax M2.1 (0.3 - 1.2)",
        },
        "gpt-5-codex": {
          "id": "gpt-5-codex",
          "name": "GPT-5 Codex (2.0 - 16.0)",
        },
        "gpt-5-codex-mini": {
          "id": "gpt-5-codex-mini",
          "name": "GPT-5 Codex Mini (2.0 - 16.0)",
        },
        "gpt-5.1": {
          "id": "gpt-5.1",
          "name": "GPT-5.1 (2.0 - 16.0)",
        },
        "gpt-5.1-codex": {
